{
  "default_model": "qwen3_4b",
  "models": {
    "qwen3_4b": {
      "model": {
        "name": "Qwen/Qwen3-4B",
        "tokenizer_name": "Qwen/Qwen3-4B",
        "revision": null,
        "torch_dtype": "bfloat16",
        "device_map": "mps",
        "trust_remote_code": false,
        "adapter_path": null
      },
      "quantization": {
        "enabled": false,
        "load_in_4bit": true,
        "bnb_4bit_quant_type": "nf4",
        "bnb_4bit_compute_dtype": "bfloat16",
        "bnb_4bit_use_double_quant": true
      },
      "tokenizer": {
        "max_input_length": 1024,
        "padding_side": "left",
        "truncation": true,
        "chat_template_kwargs": {
          "enable_thinking": false
        }
      },
      "generation": {
        "max_new_tokens": 32,
        "do_sample": false,
        "temperature": null,
        "top_p": null
      },
      "decision": {
        "relevance_threshold": 0.5,
        "on_parse_failure": "relevant"
      },
      "lora": {
        "r": 32,
        "lora_alpha": 64,
        "lora_dropout": 0.05,
        "bias": "none",
        "task_type": "CAUSAL_LM",
        "target_modules": [
          "q_proj",
          "k_proj",
          "v_proj",
          "o_proj"
        ]
      },
      "training": {
        "output_dir": "outputs/qwen3_4b_lora",
        "max_seq_length": 1024,
        "num_train_epochs": 3,
        "learning_rate": 0.0002,
        "lr_scheduler_type": "cosine",
        "warmup_ratio": 0.03,
        "weight_decay": 0.0,
        "optimizer": "adamw_torch",
        "per_device_train_batch_size": 4,
        "per_device_eval_batch_size": 8,
        "gradient_accumulation_steps": 8,
        "gradient_checkpointing": true,
        "bf16": true,
        "logging_steps": 10,
        "eval_strategy": "epoch",
        "save_strategy": "epoch",
        "k_folds": 5,
        "seed": 42
      }
    }
  }
}