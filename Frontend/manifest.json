{
  "manifest_version": 3,
  "name": "LockDown — Focus",
  "version": "0.1.0",
  "description": "Start a focus session and block distracting sites while you work.",

  "action": {
    "default_popup": "popup.html",
    "default_title": "LockDown"
  },

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "permissions": [
    "storage",
    "declarativeNetRequest",
    "tabs",
    "alarms",
    "idle"
  ],

  "host_permissions": [
    "http://127.0.0.1:8000/*"
  ]
}
